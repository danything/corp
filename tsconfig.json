{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": false,
    "types": ["bun"],
    "paths": {
      "@components/*": ["./src/components/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "server/**/*",
    "scripts/**/*",
    "tests/**/*",
    "server.ts",
    "astro.config.ts"
  ]
}
