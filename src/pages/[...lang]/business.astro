---
import Layout from "@layouts/Layout.astro";
import Facts from "@components/Facts.astro";
import ServiceFeatures from "@components/ServiceFeatures.astro";
import { type Lang, langPaths, localeUrl, t } from "@i18n/translation";
import { business } from "@/config";

// 事業内容(/business/ と /en/business/)。事業ごとの節は #dev・#cars などで、トップから飛んでくる
export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const text = t(lang);
const page = text.businessPage;
const [licenseBefore, licenseAfter] = page.licenseNote.split("{link}");
---

<Layout title={page.title} description={page.description}>
	<h1>{page.title}</h1>

	{business.map((id) => (
		<section class="business" aria-labelledby={id}>
			<h2 id={id} data-reveal>{text.business[id].title}</h2>
			<p class="body" data-reveal>{text.business[id].body}</p>

			{id === "dev" && (
				<>
					<h3 data-reveal>{page.techTitle}</h3>
					<Facts data-reveal>
						{page.tech.map((row) => (
							<>
								<dt>{row.label}</dt>
								<dd>{row.value}</dd>
							</>
						))}
					</Facts>
					<p data-reveal><a class="button secondary" href={localeUrl("/works/", lang)}>{page.worksLink} <span class="arrow" aria-hidden="true">→</span></a></p>
				</>
			)}

			{id === "cars" && (
				<p class="muted" data-reveal>{licenseBefore}<a href={localeUrl("/company/", lang)}>{page.licenseLink}</a>{licenseAfter}</p>
			)}

			{id === "services" && <ServiceFeatures lang={lang} />}
		</section>
	))}
</Layout>

<style>
/* 事業ごとの小見出し (使う技術) */
.business > h3 {
  font-size: var(--doa-text-lg);
  line-height: 1.5;
  margin-block: var(--doa-space-6) var(--doa-space-4);
}
</style>
