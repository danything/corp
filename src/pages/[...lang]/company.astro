---
import Layout from "@layouts/Layout.astro";
import Facts from "@components/Facts.astro";
import { type Lang, langPaths, localeUrl, t } from "@i18n/translation";
import { business, career, licenses, site } from "@/config";

// 事業者情報と代表のプロフィール(/company/ と /en/company/。プロフィールは #profile)
export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const text = t(lang);
const c = text.company;
const p = text.profile;

const MONTHS = [
	"Jan",
	"Feb",
	"Mar",
	"Apr",
	"May",
	"Jun",
	"Jul",
	"Aug",
	"Sep",
	"Oct",
	"Nov",
	"Dec",
];
/** "2020-01" → 2020年1月 / Jan 2020。年だけ ("2016") ならそのまま年 */
function formatYm(ym: string): string {
	const [y, m] = ym.split("-");
	if (!m) return lang === "en" ? y : `${y}年`;
	return lang === "en"
		? `${MONTHS[Number(m) - 1]} ${y}`
		: `${y}年${Number(m)}月`;
}
const sep = lang === "en" ? " – " : "〜";
const [ossBefore, ossAfter] = p.oss.split("{link}");
---

<Layout title={c.title} description={c.description}>
	<h1>{c.title}</h1>
	<Facts>
		<dt>{c.tradeName}</dt>
		<dd>{site.name}</dd>

		<dt>{c.representative}</dt>
		<dd>{c.representativeName}</dd>

		<dt>{c.location}</dt>
		<dd>{c.locationValue}</dd>

		<dt>{c.founded}</dt>
		<dd>{c.foundedValue}</dd>

		<dt>{c.business}</dt>
		<dd>
			<ul>
				{business.map((id) => <li><a href={localeUrl(`/business/#${id}`, lang)}>{text.business[id].title}</a></li>)}
			</ul>
		</dd>

		<dt>{c.license}</dt>
		<dd><span lang="ja">長野県公安委員会 {site.kobutsuNumber}</span>{lang === "en" && ` (${c.licenseValue})`}</dd>

		<dt>{c.invoice}</dt>
		<dd><a href={`https://www.invoice-kohyo.nta.go.jp/regno-search/detail?selRegNo=${site.invoiceNumber.slice(1)}`}>{site.invoiceNumber}</a></dd>

		<dt>{c.email}</dt>
		<dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
	</Facts>

	<section class="profile" aria-labelledby="profile">
		<h2 id="profile">{p.title}</h2>
		<p class="lead">{p.lead}</p>

		<h3 id="career">{p.careerTitle}</h3>
		<ol class="timeline" aria-labelledby="career">
			{career.map((e) => (
				<li>
					<p class="period">
						<time datetime={e.from}>{formatYm(e.from)}</time>{sep}{"to" in e ? <time datetime={e.to}>{formatYm(e.to)}</time> : <span>{p.present}</span>}
					</p>
					<div>
						<p class="what">{p.career[e.id].title}</p>
						{p.career[e.id].body && <p class="detail">{p.career[e.id].body}</p>}
					</div>
				</li>
			))}
		</ol>

		<h3 id="licenses">{p.licensesTitle}</h3>
		<ol class="timeline" aria-labelledby="licenses">
			{licenses.map((l) => (
				<li>
					<p class="period"><time datetime={l.date}>{formatYm(l.date)}</time></p>
					<div>
						<p class="what">{p.licenses[l.id]}</p>
					</div>
				</li>
			))}
		</ol>
		<p class="body">{ossBefore}<a href={localeUrl("/works/#oss", lang)}>{p.ossLink}</a>{ossAfter}</p>
	</section>
</Layout>

<style>
/* 代表のプロフィール (事業者情報の表の下) */
.profile {
  margin-top: clamp(3.5rem, 8vw, 5.5rem);
}

.profile h3 {
  font-size: var(--doa-text-lg);
  line-height: 1.5;
  margin-block: var(--doa-space-6) var(--doa-space-4);
}

/*
 * 経歴と資格の年表 (<ol>)。事業者情報の表と同じく、線も面も付けずに行の間の余白で分ける。
 * 年月は控えた字。広い画面では年月と中身を横に並べる
 */
.timeline {
  display: grid;
  gap: var(--doa-space-5);
  max-width: 48rem;
  margin: 0 0 var(--doa-space-5);
  padding: 0;
  list-style: none;
}

.timeline li {
  display: grid;
  gap: var(--doa-space-1) var(--doa-space-6);
  margin: 0;
  list-style: none;
}

.timeline .period {
  color: var(--doa-muted);
  font-size: var(--doa-text-sm);
  font-variant-numeric: tabular-nums;
}

.timeline time {
  white-space: nowrap;
}

.timeline .what {
  font-weight: var(--doa-weight-bold);
}

.timeline .detail {
  margin-top: var(--doa-space-1);
  font-size: 0.9375rem;
}

@media (min-width: 640px) {
  .timeline li {
    grid-template-columns: 11rem 1fr;
  }

  .timeline .period {
    padding-top: 0.15rem;
  }
}
</style>
