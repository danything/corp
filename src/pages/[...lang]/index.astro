---
import HeroShots from "@components/HeroShots.astro";
import { type Lang, langPaths, localeUrl, t } from "@i18n/translation";
import Layout from "@layouts/Layout.astro";
import { business, site } from "@/config";

// トップ(/ と /en/)。要約だけを置き、詳しくは事業内容・実績・事業者情報の各ページに書く
export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const text = t(lang);
---

<Layout>
	<section class="hero">
		<div class="hero-text">
			<h1>{site.name}</h1>
			<p class="hero-lead">{text.home.lead}</p>
			<div class="actions">
				<a class="button" href={localeUrl("/contact/", lang)}>{text.home.ctaContact}</a>
				<a class="button secondary" href={localeUrl("/business/", lang)}>{text.home.ctaBusiness} <span class="arrow" aria-hidden="true">→</span></a>
			</div>
		</div>
		<HeroShots lang={lang} />
	</section>

	<section aria-labelledby="business">
		<h2 id="business" data-reveal>{text.home.businessTitle}</h2>
		<ul class="cards">
			{business.map((id) => (
				<li class="item" data-reveal>
					<h3><a href={localeUrl(`/business/#${id}`, lang)}>{text.business[id].title}</a></h3>
					<p>{text.business[id].summary}</p>
				</li>
			))}
		</ul>
	</section>

	<section aria-labelledby="contact" data-reveal>
		<h2 id="contact">{text.home.contactTitle}</h2>
		<p class="lead">{text.home.contactBody}</p>
		<div class="actions">
			<a class="button" href={localeUrl("/contact/", lang)}>{text.home.ctaContact}</a>
			<a class="button secondary" href={`mailto:${site.email}`}>{site.email}</a>
		</div>
	</section>
</Layout>
