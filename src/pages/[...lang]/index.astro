---
import { type Lang, langPaths, localeUrl, t } from "@i18n/translation";
import Layout from "@layouts/Layout.astro";
import { services, site } from "@/config";

// トップ(/ と /en/)
export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const text = t(lang);
---

<Layout>
	<section class="hero">
		<p class="hero-meta">{text.home.meta}</p>
		<h1>{site.name}</h1>
		<p class="hero-lead">{text.home.lead}</p>
		<div class="actions">
			<a class="button" href={localeUrl("/contact/", lang)}>{text.home.ctaContact}</a>
			<a class="button secondary" href={localeUrl("/works/", lang)}>{text.home.ctaWorks} <span class="arrow" aria-hidden="true">→</span></a>
		</div>
	</section>

	<section aria-labelledby="business">
		<h2 id="business" data-reveal>{text.home.businessTitle}</h2>
		<ul class="cards">
			{text.home.business.map((b) => (
				<li class="item" data-reveal>
					<h3>{b.title}</h3>
					<p>{b.body}</p>
				</li>
			))}
		</ul>
	</section>

	<section aria-labelledby="services">
		<h2 id="services" data-reveal>{text.home.servicesTitle}</h2>
		<p class="lead" data-reveal>{text.home.servicesLead}</p>
		<ul class="cards">
			{services.map((s) => (
				<li class="item" data-reveal>
					<h3><a href={s.url}>{text.services[s.id].name}</a></h3>
					<p>{text.services[s.id].body}</p>
				</li>
			))}
		</ul>
		<p data-reveal><a class="button secondary" href={localeUrl("/works/", lang)}>{text.home.worksLink} <span class="arrow" aria-hidden="true">→</span></a></p>
	</section>

	<section aria-labelledby="about" data-reveal>
		<h2 id="about">{text.home.aboutTitle}</h2>
		<p class="body">{text.home.aboutBody}</p>
		<p><a class="button secondary" href={localeUrl("/company/#profile", lang)}>{text.home.aboutLink} <span class="arrow" aria-hidden="true">→</span></a></p>
	</section>

	<section aria-labelledby="contact" data-reveal>
		<h2 id="contact">{text.home.contactTitle}</h2>
		<p class="lead">{text.home.contactBody}</p>
		<div class="actions">
			<a class="button" href={localeUrl("/contact/", lang)}>{text.home.ctaContact}</a>
			<a class="button secondary" href={`mailto:${site.email}`}>{site.email}</a>
		</div>
	</section>
</Layout>
