---
import BrowserFrame from "@components/BrowserFrame.astro";
import { type Lang, t } from "@i18n/translation";
import todoroku from "@/assets/hero/todoroku.webp";
import worklogDark from "@/assets/hero/worklog-dark.webp";
import worklogLight from "@/assets/hero/worklog-light.webp";
import { services } from "@/config";

/*
 * トップの頭の右 (狭い画面では下) に出す、自社サービスの画面。トップページを 1280×800 で撮ったもの
 * (2 倍の解像度)。worklog は明暗があるので選んだ明暗 (OS か ThemeSwitch) で出し分け、トドロクは明るいほうしか無い。
 * 前に重ねる worklog がページでいちばん大きい絵 (LCP) なので優先して取る (明暗 2 枚のうち見える側だけ。ShotPicture.astro)。後ろのトドロクは遅延でよい
 */
interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang);

// 広い画面では列の 8 割 (最大 480px 前後)、狭い画面では幅の 8 割
const sizes = "(min-width: 960px) 30rem, 80vw";

const url = Object.fromEntries(services.map((s) => [s.id, s.url])) as Record<
	(typeof services)[number]["id"],
	string
>;
const host = (u: string) => new URL(u).host;
---

<div class="hero-shots">
	<BrowserFrame
		class="shot-front"
		href={url.worklog}
		label={host(url.worklog)}
		src={worklogLight}
		dark={worklogDark}
		alt={text.home.shots.worklog}
		sizes={sizes}
		width={1280}
		height={800}
		priority
	/>
	<BrowserFrame
		class="shot-back"
		href={url.todoroku}
		label={host(url.todoroku)}
		src={todoroku}
		alt={text.home.shots.todoroku}
		sizes={sizes}
		width={1280}
		height={800}
	/>
	<ul class="hero-links" aria-label={text.home.shotsLabel}>
		{services.map((s) => (
			<li>
				<a class="button secondary" href={s.url}>
					{text.services[s.id].name}
					<span class="host">{host(s.url)}</span>
					<span class="arrow" aria-hidden="true">→</span>
				</a>
			</li>
		))}
	</ul>
</div>

<style>
/*
 * 自社サービスの画面を 2 枚、斜めにずらして重ねる。窓の枠は BrowserFrame.astro で、
 * ここで渡した class (shot-front・shot-back) と scoped の印が枠に付く
 */
.hero-shots {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  max-width: 40rem;
}

.hero-shots .shot {
  grid-area: 1 / 1;
  width: 82%;
}

.shot-front {
  z-index: 1;
  justify-self: start;
  margin-top: 20%;
}

.shot-back {
  justify-self: end;
  /* 同じ升に重ねる前の窓のほうが下まで長いので、伸ばさず絵の高さで止める */
  align-self: start;
}

/* 画面の下に、同じサービスへの平らなリンクを並べる (控えのボタンと同じ。塗らず、乗せたら薄い地) */
.hero-links {
  grid-area: 2 / 1;
  display: flex;
  flex-wrap: wrap;
  gap: var(--doa-space-1) var(--doa-space-2);
  margin: var(--doa-space-5) 0 0;
  padding: 0;
  list-style: none;
}

.hero-links li {
  margin: 0;
  list-style: none;
}

.hero-links a.button {
  padding-inline: var(--doa-space-3);
}

/*
 * トップの名前・一文・ボタン (index.astro) に続いて、画面の 2 枚とリンクがふわっと入る。
 * 巻くのに合わせて動かせるブラウザでは、画面の 2 枚は BrowserFrame.astro の rise + drift に任せる
 * (ここで animation を書くと drift を消してしまい、2 枚が逃げなくなる)
 */
@media (prefers-reduced-motion: no-preference) {
  .hero-links {
    animation: rise var(--doa-duration-reveal) var(--doa-ease) both;
    animation-delay: calc(var(--i, 0) * 70ms);
  }

  .shot-back {
    --i: 3;
  }

  .shot-front {
    --i: 4;
  }

  .hero-links {
    --i: 5;
  }
}

@supports not (animation-timeline: scroll()) {
  @media (prefers-reduced-motion: no-preference) {
    .hero-shots .shot {
      animation: rise var(--doa-duration-reveal) var(--doa-ease) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }
  }
}

/* 巻いたときに上へ逃げる量 (BrowserFrame.astro の drift)。前の 1 枚のほうを速く */
@supports (animation-timeline: scroll()) {
  @media (prefers-reduced-motion: no-preference) {
    .shot-back {
      --drift: -0.75rem;
    }

    .shot-front {
      --drift: -2.25rem;
    }
  }
}

/*
 * 広い画面では 2 枚を奥へ少し傾けて置き、巻くと起き上がって正面を向く (transform だけを scroll() で動かす)
 */
@supports (animation-timeline: scroll()) {
  @media (min-width: 960px) and (prefers-reduced-motion: no-preference) {
    .hero-shots {
      transform: perspective(1600px) rotateY(-14deg) rotateX(6deg);
      animation: stand-up linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 70vh;
    }
  }
}

@keyframes stand-up {
  to {
    transform: perspective(1600px) rotateY(0) rotateX(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-links {
    animation: none;
  }
}
</style>
