---
import ShotPicture from "@components/ShotPicture.astro";

/*
 * 自社サービスや実績の画面 (トップの頭・事業内容の自社サービス・実績)。ブラウザの窓に見立てた枠 (細い帯に label) に入れる。
 * href があれば枠ごとリンクにする。置き方 (重ねる・ずらす) は使う側が class で決める
 * (class と、使う側の scoped の印 data-astro-cid-* を枠に渡す)
 */
interface Props {
	label: string;
	href?: string;
	src: ImageMetadata;
	dark?: ImageMetadata;
	alt: string;
	sizes: string;
	width: number;
	height: number;
	priority?: boolean;
	class?: string;
	style?: string;
	[attr: `data-${string}`]: unknown;
}

const {
	label,
	href,
	src,
	dark,
	alt,
	sizes,
	width,
	height,
	priority,
	class: className,
	...attrs
} = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class:list={["shot", className]} href={href} {...attrs}>
	<span class="shot-bar"><span class="shot-dots" aria-hidden="true"></span>{label}</span>
	<ShotPicture src={src} dark={dark} alt={alt} sizes={sizes} width={width} height={height} priority={priority} />
</Tag>

<style>
/* 枠は件の面と同じ面に、操作の層の影 */
.shot {
  display: block;
  overflow: hidden;
  border-radius: var(--doa-radius-lg);
  background: var(--doa-item);
  box-shadow:
    0 0 0 1px var(--doa-line),
    var(--doa-shadow-pop);
  color: var(--doa-muted);
  text-decoration: none;
  transition: box-shadow var(--doa-duration) var(--doa-ease);
}

.shot:hover {
  box-shadow:
    0 0 0 1px var(--doa-line-strong),
    var(--doa-shadow-pop);
}

.shot-bar {
  display: flex;
  align-items: center;
  gap: var(--doa-space-3);
  height: 1.75rem;
  padding-inline: var(--doa-space-3);
  background: var(--doa-subtle);
  font-family: var(--doa-font-mono);
  font-size: var(--doa-text-xs);
  line-height: 1;
}

/* 窓の左上の 3 つの丸 */
.shot-dots {
  flex: none;
  width: 0.375rem;
  height: 0.375rem;
  margin-right: 0.875rem;
  border-radius: 50%;
  background: var(--doa-line-strong);
  box-shadow:
    0.625rem 0 var(--doa-line-strong),
    1.25rem 0 var(--doa-line-strong);
}

/*
 * 巻くと、前の 1 枚が後ろの 1 枚より少しだけ速く上へ逃げる (奥行き)。animation-timeline: scroll() で、JS は使わない。
 * 入ってくる動き (rise・translate) と並べて transform を動かす。知らないブラウザは止まったまま。
 * 逃げる量 (--drift) と入る順 (--i) は使う側が決める
 */
@supports (animation-timeline: scroll()) {
  @media (prefers-reduced-motion: no-preference) {
    .shot {
      animation:
        rise var(--doa-duration-reveal) var(--doa-ease) both,
        drift linear both;
      animation-delay: calc(var(--i, 0) * 70ms), 0s;
      animation-timeline: auto, scroll(root block);
      animation-range:
        normal,
        0 100vh;
    }
  }
}

@keyframes drift {
  to {
    transform: translateY(var(--drift, 0));
  }
}

@media (prefers-reduced-motion: reduce) {
  .shot {
    animation: none;
  }
}
</style>
