---
import Feature from "@components/Feature.astro";
import { type Lang, t } from "@i18n/translation";
import todoroku from "@/assets/hero/todoroku.webp";
import worklogDark from "@/assets/hero/worklog-dark.webp";
import worklogLight from "@/assets/hero/worklog-light.webp";
import { services } from "@/config";

/*
 * 事業内容の自社サービス。1 件ずつ横長にして、説明の隣にトップと同じ画面 (1280×800 のトップページ) を置く。
 * worklog は選んだ明暗 (OS か ThemeSwitch) で画面を出し分け、トドロクは明るいほうしか無い
 */
interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang);
const page = text.businessPage;

// 広い画面では件の右の列 (最大 36rem 前後)、狭い画面では幅いっぱい
const sizes = "(min-width: 860px) 36rem, 90vw";

const shots = {
	todoroku: { src: todoroku, dark: undefined },
	worklog: { src: worklogLight, dark: worklogDark },
};
---

<ul class="features">
	{services.map((s) => (
		<Feature
			name={text.services[s.id].name}
			href={s.url}
			body={text.services[s.id].body}
			open={page.openSite}
			frame={{
				label: new URL(s.url).host,
				...shots[s.id],
				alt: text.home.shots[s.id],
				sizes,
				width: 1280,
				height: 800,
			}}
		/>
	))}
</ul>

<style>
/*
 * 事業内容の自社サービス。横長の件 (Feature.astro) にして、左に説明、右にサービスの画面 (トップと同じ窓の枠) を置く。
 * 狭い画面では画面を説明の下に回す
 */
.features {
  display: grid;
  gap: var(--doa-space-5);
  margin: 0 0 var(--doa-space-5);
  padding: 0;
  list-style: none;
}
</style>
