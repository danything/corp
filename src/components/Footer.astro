---
import { type Lang, localeUrl, t } from "@i18n/translation";
import { github, services, site, socialLinks } from "@/config";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang);
---

<footer class="site-footer wrap">
	<ul aria-label={text.footer.social}>
		<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
		<li><a href={site.blog}>{text.footer.blog}</a></li>
		<li><a href={github.org.url}>GitHub ({github.org.name})</a></li>
		{socialLinks.map((s) => (
			<li><a href={s.url} rel="me">{s.name}{s.name === "GitHub" ? ` (${github.user.name})` : ""}</a></li>
		))}
	</ul>
	<p>
		<a href={localeUrl("/company/", lang)}>{text.nav.company}</a> ·
		<a href={localeUrl("/privacy/", lang)}>{text.footer.privacy}</a> ·
		{text.footer.tokushoho}:
		{services.map((s, i) => (<>{i > 0 && "・"}<a href={new URL("/legal", s.url).href}>{text.services[s.id].name}</a></>))} ·
		{text.footer.copyright}
	</p>
</footer>

<style>
/* ---- 足 ---- */
.site-footer {
  margin-top: 6rem;
  padding-block: var(--doa-space-6) var(--doa-space-6);
  color: var(--doa-muted);
  font-size: var(--doa-text-sm);
}

.site-footer ul {
  display: flex;
  flex-wrap: wrap;
  gap: var(--doa-space-1) var(--doa-space-4);
  margin-bottom: var(--doa-space-3);
  padding: 0;
  list-style: none;
}

.site-footer li {
  margin: 0;
  list-style: none;
}

.site-footer ul a {
  color: var(--doa-fg);
  text-decoration: none;
}

.site-footer ul a:hover {
  color: var(--pico-primary);
  text-decoration: underline;
}

.site-footer p a {
  color: var(--doa-muted);
}
</style>
