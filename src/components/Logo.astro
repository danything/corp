---
import { Image } from "astro:assets";

/*
 * 名前の前に置くアイコン (実績の件の見出し)。アプリのアイコンは台ごとの絵なのでそのまま、ほかの物のロゴは白い台に載せる
 * (plate。ロゴの色は明暗どちらの背景でも白の上で見えるように作られている)
 */
interface Props {
	src: ImageMetadata;
	plate?: boolean;
}

const { src, plate } = Astro.props;
---

<span class:list={["row-icon", { plate }]}><Image src={src} alt="" width={40} height={40} /></span>

<style>
.row-icon {
  display: grid;
  flex: none;
  place-items: center;
  width: 2.5rem;
  height: 2.5rem;
  overflow: hidden;
  border-radius: var(--doa-radius-lg);
}

.row-icon img {
  width: 100%;
  height: 100%;
}

.row-icon.plate {
  padding: 0.375rem;
  background: #fff;
  box-shadow: 0 0 0 1px var(--doa-line);
}

.row-icon.plate img {
  object-fit: contain;
}
</style>
