---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import {
	DEFAULT_LANG,
	LANGS,
	langFromPath,
	localeUrl,
	stripLang,
	t,
} from "@i18n/translation";
import { site, socialLinks } from "@/config";
import "../styles/main.css";

interface Props {
	/** ページの題。無ければ(トップ)サイト名だけ */
	title?: string;
	description?: string;
	/** 検索に出さないページ(送信完了) */
	noindex?: boolean;
}

const { title, description, noindex } = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const text = t(lang);
const pageTitle = title
	? `${title} | ${site.name}`
	: `${site.name} — ${text.home.lead}`;
const metaDescription = description ?? text.siteDescription;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// 日本語版と英語版は /en/ を除いて同じパス
const basePath = stripLang(Astro.url.pathname);
const alternates = LANGS.map((l) => ({
	lang: l,
	href: new URL(localeUrl(basePath, l), Astro.site).href,
}));
const ogImage = new URL(site.ogImage, Astro.site).href;

// 検索エンジン向けの事業者の情報(トップだけ)
const jsonLd =
	basePath === "/"
		? {
				"@context": "https://schema.org",
				"@type": "Organization",
				name: site.name,
				url: new URL(localeUrl("/", lang), Astro.site).href,
				logo: new URL("/static/favicons/apple-touch-icon.png", Astro.site).href,
				email: site.email,
				foundingDate: site.foundingDate,
				founder: {
					"@type": "Person",
					name: text.company.representativeName.replace(/（.*）/, ""),
				},
				address: {
					"@type": "PostalAddress",
					addressLocality: lang === "en" ? "Kisarazu" : "木更津市",
					addressRegion: lang === "en" ? "Chiba" : "千葉県",
					addressCountry: "JP",
				},
				sameAs: socialLinks.map((s) => s.url),
			}
		: undefined;
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={metaDescription} />
		{noindex && <meta name="robots" content="noindex" />}

		<link rel="canonical" href={canonicalUrl} />
		{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
		<link rel="alternate" hreflang="x-default" href={new URL(localeUrl(basePath, DEFAULT_LANG), Astro.site).href} />

		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content={lang === "en" ? "en_US" : "ja_JP"} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{/* X はタイトル・説明・画像の twitter:* が無ければ og:* を使うので、カードの形だけを書く */}
		<meta name="twitter:card" content="summary_large_image" />

		<meta name="color-scheme" content="light dark" />
		<link rel="icon" href="/static/favicons/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" href="/static/favicons/favicon-16x16.png" sizes="16x16" />
		<link rel="apple-touch-icon" href="/static/favicons/apple-touch-icon.png" sizes="180x180" />
		<meta name="generator" content={Astro.generator} />
		{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#main">{text.skipToContent}</a>
		<Header lang={lang} />
		<main id="main" class="container">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
