---
import "../styles/main.css";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import {
	DEFAULT_LANG,
	LANGS,
	langFromPath,
	localeUrl,
	stripLang,
	t,
} from "@i18n/translation";
import { site, socialLinks } from "@/config";

interface Props {
	/** ページの題。無ければ(トップ)サイト名だけ */
	title?: string;
	description?: string;
	/** 検索に出さないページ(送信完了) */
	noindex?: boolean;
}

const { title, description, noindex } = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const text = t(lang);
const pageTitle = title
	? `${title} | ${site.name}`
	: `${site.name} | ${text.home.title}`;
const metaDescription = description ?? text.siteDescription;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// 日本語版と英語版は /en/ を除いて同じパス
const basePath = stripLang(Astro.url.pathname);
const alternates = LANGS.map((l) => ({
	lang: l,
	href: new URL(localeUrl(basePath, l), Astro.site).href,
}));
const ogImage = new URL(site.ogImage, Astro.site).href;

/*
 * ブラウザの Speculation Rules で、サイトの中のページを開かれる前に読んでおく (ブログと同じ)。
 * どちらもマウスを少し乗せた時点。スマホでは画面に見えているリンク (eagerness は eager)。
 * - prerender (裏で描画まで済ませる): 押したら待たずに切り替わる
 * - prefetch (HTML だけを取る): prerender が間に合わない・数の上限で捨てられたときも、通信は待たずに済む
 * お問い合わせ (/contact/) は prefetch だけにする。裏で描くとボット対策 (Turnstile) の枠を開く前に作ってしまい、
 * 確かめの期限が開いたときに切れていることがある。裏で描いたページの明暗は、開かれたときに合わせ直す (下の head のスクリプト)。
 * 対応していないブラウザ (Firefox・Safari) では普通に移る
 * https://developer.chrome.com/docs/web-platform/prerender-pages
 */
const speculationTargets = {
	source: "document",
	where: {
		and: [
			{ href_matches: "/*" },
			// ページではないもの (サイトマップ・画像・問い合わせの API など)
			{
				not: {
					href_matches: [
						"/*.xml",
						"/*.txt",
						"/static/*",
						"/_astro/*",
						"/api/*",
					],
				},
			},
			// 同じページの中への移動と、新しいタブで開くもの・ダウンロード
			{ not: { selector_matches: ['[href^="#"]', "[target]", "[download]"] } },
		],
	},
};
const contactPages = [localeUrl("/contact/*", "ja"), localeUrl("/contact/*", "en")];
const speculationRules = {
	prefetch: [{ ...speculationTargets, eagerness: "eager" }],
	prerender: [
		{
			...speculationTargets,
			where: {
				and: [
					...speculationTargets.where.and,
					{ not: { href_matches: contactPages } },
				],
			},
			eagerness: "eager",
		},
	],
};

// 検索エンジン向けの事業者の情報(トップだけ)
const jsonLd =
	basePath === "/"
		? {
				"@context": "https://schema.org",
				"@type": "Organization",
				name: site.name,
				url: new URL(localeUrl("/", lang), Astro.site).href,
				logo: new URL("/static/favicons/apple-touch-icon.png", Astro.site).href,
				email: site.email,
				foundingDate: site.foundingDate,
				founder: {
					"@type": "Person",
					name: text.company.representativeName.replace(/（.*）/, ""),
				},
				address: {
					"@type": "PostalAddress",
					addressLocality: lang === "en" ? "Kisarazu" : "木更津市",
					addressRegion: lang === "en" ? "Chiba" : "千葉県",
					addressCountry: "JP",
				},
				sameAs: socialLinks.map((s) => s.url),
			}
		: undefined;
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={metaDescription} />
		{noindex && <meta name="robots" content="noindex" />}

		<link rel="canonical" href={canonicalUrl} />
		{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
		<link rel="alternate" hreflang="x-default" href={new URL(localeUrl(basePath, DEFAULT_LANG), Astro.site).href} />

		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content={lang === "en" ? "en_US" : "ja_JP"} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{/* X はタイトル・説明・画像の twitter:* が無ければ og:* を使うので、カードの形だけを書く */}
		<meta name="twitter:card" content="summary_large_image" />

		<meta name="color-scheme" content="light dark" />
		{/*
			選んだ明暗 (ThemeSwitch が localStorage に置く) を描く前に <html> へ移す。無ければ OS に従う。
			裏で描いた (prerender) ページは、描いてから開かれるまでに別のページで明暗を変えていることがあるので、開かれたときにもう一度移す
		*/}
		<script is:inline>
			{
				const apply = () => {
					try {
						const t = localStorage.getItem("theme");
						if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
						else delete document.documentElement.dataset.theme;
					} catch {}
				};
				apply();
				if (document.prerendering) document.addEventListener("prerenderingchange", apply, { once: true });
			}
		</script>
		<script is:inline type="speculationrules" set:html={JSON.stringify(speculationRules)} />
		<link rel="icon" href="/static/favicons/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" href="/static/favicons/favicon-16x16.png" sizes="16x16" />
		<link rel="apple-touch-icon" href="/static/favicons/apple-touch-icon.png" sizes="180x180" />
		<meta name="generator" content={Astro.generator} />
		{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#main">{text.skipToContent}</a>
		<Header lang={lang} />
		<main id="main" class="wrap">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
